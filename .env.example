# NADI (Team ASURA) — copy to .env and fill. .env is human-owned; Claude Code never reads or edits it.
# Nothing here requires a card. Blank optional keys are fine — /health reports what is live.

# --- LLM provider chain (at least ONE of the two required) ---
# aistudio.google.com -> Get API key
GEMINI_API_KEY=
# console.groq.com -> API keys
GROQ_API_KEY=

# --- Local infra (defaults match docker-compose.yml; leave as-is) ---
DATABASE_URL=postgresql+asyncpg://nadi:nadi@localhost:5432/nadi
REDIS_URL=redis://localhost:6379/0
OLLAMA_BASE_URL=http://localhost:11434

# --- App ---
APP_ENV=local
LOG_LEVEL=info
LLM_CACHE_DIR=.cache/llm
ROUTER_SEED=1337

# --- OPTIONAL: deploy only (hour 11:30). Leave blank to skip deploy entirely. ---
# supabase.com -> project asura-nadi (Singapore) -> Session-mode pooler string
PROD_DATABASE_URL=
# upstash.com -> Redis, free, Singapore
PROD_REDIS_URL=
# huggingface.co -> Settings -> Access Tokens -> write
HF_TOKEN=
HF_SPACE_ID=
# vercel.com -> sign in with GitHub (vercel CLI logs in interactively; no key needed)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
