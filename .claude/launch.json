{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--project", "demo/backend", "uvicorn", "app.main:app", "--app-dir", "demo/backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "demo-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5500", "--directory", "demo/frontend"],
      "port": 5500
    }
  ]
}
